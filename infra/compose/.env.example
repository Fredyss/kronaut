# Public origin of the app, served through the tunnel and protected by Cloudflare Access.
KRONAUT_PUBLIC_URL=https://kronaut.example.com
# Public origin of the media role; must differ from the app origin and has no Access.
KRONAUT_MEDIA_URL=https://media.example.com
# Cloudflare One team domain (Zero Trust > Settings). Required: the app refuses requests without Access.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Application Audience (AUD) tag of the Access application on the app hostname. Required.
ACCESS_AUD=replace-with-your-access-aud
# Image the stack builds and runs.
KRONAUT_IMAGE=kronaut:local
# Log level: fatal, error, warn, info, debug, trace or silent.
KRONAUT_LOG_LEVEL=info
# Comma-separated emails that may open Settings > System (instance health). Empty = nobody.
KRONAUT_INSTANCE_ADMINS=
# IANA time zone for container clocks and log timestamps.
TZ=UTC
# Directory holding the secret files written by init-secrets.sh, relative to this file.
KRONAUT_SECRETS_DIR=../../secrets
# Host directory mounted at /backup in the backup service (nightly archives) and the cli service (export and import).
KRONAUT_BACKUP_DIR=../../data/backups
# Local time of the nightly backup, as HH:MM (24-hour).
KRONAUT_BACKUP_TIME=03:30
# IANA time zone that KRONAUT_BACKUP_TIME is read in, for example Europe/Bratislava.
KRONAUT_BACKUP_TIMEZONE=UTC
# Optional SMTP server for notification emails. Leave KRONAUT_SMTP_HOST empty to send none.
KRONAUT_SMTP_HOST=
# 587 by default; 465 switches the default TLS mode to tls.
KRONAUT_SMTP_PORT=587
# Login, if the server needs one. Its password goes in secrets/smtp_password, never here.
KRONAUT_SMTP_USER=
# Sender address, required once the host is set, for example kronaut@smtp.example.com.
KRONAUT_SMTP_FROM=
# starttls (default), tls (implicit TLS, the default on 465) or none (local relay only). Certificates are always verified.
KRONAUT_SMTP_TLS=
