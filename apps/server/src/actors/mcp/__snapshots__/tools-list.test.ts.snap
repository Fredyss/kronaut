    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": false,
      },
      "description": "Ask a human to approve a draft post. body is the posts.request_approval request body, with expectedVersion.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "acknowledgedCodes": {
                "items": {
                  "pattern": "^[a-z_]{1,64}$",
                  "type": "string",
                },
                "maxItems": 32,
                "type": "array",
              },
              "expectedVersion": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "note": {
                "maxLength": 2000,
                "type": "string",
              },
              "repeat": {
                "additionalProperties": false,
                "properties": {
                  "byDay": {
                    "items": {
                      "enum": [
                        "mo",
                        "tu",
                        "we",
                        "th",
                        "fr",
                        "sa",
                        "su",
                      ],
                      "type": "string",
                    },
                    "maxItems": 7,
                    "minItems": 1,
                    "type": "array",
                  },
                  "byMonthDay": {
                    "maximum": 31,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "count": {
                    "maximum": 500,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "freq": {
                    "enum": [
                      "daily",
                      "weekly",
                      "monthly",
                    ],
                    "type": "string",
                  },
                  "interval": {
                    "maximum": 99,
                    "minimum": 1,
                    "type": "integer",
                  },
                  "until": {
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "type": "string",
                  },
                },
                "required": [
                  "freq",
                ],
                "type": "object",
              },
              "schedule": {
                "additionalProperties": false,
                "properties": {
                  "scheduleLocal": {
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z)|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$",
                    "type": "string",
                  },
                  "scheduleTz": {
                    "maxLength": 64,
                    "pattern": "^[A-Za-z_]+(\\/[A-Za-z0-9_+-]+)*$",
                    "type": "string",
                  },
                },
                "required": [
                  "scheduleLocal",
                  "scheduleTz",
                ],
                "type": "object",
              },
            },
            "required": [
              "expectedVersion",
            ],
            "type": "object",
          },
          "idempotencyKey": {
            "description": "Reuse the same key to retry safely; a different request with it is refused.",
            "pattern": "^[A-Za-z0-9_-]{8,128}$",
            "type": "string",
          },
          "postId": {
            "type": "string",
          },
        },
        "required": [
          "postId",
          "body",
          "idempotencyKey",
        ],
