{
  "attribution": {
    "commit": ""
  },
  "sandbox": {
    "enabled": false
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo:*)",
      "Bash(gh secret:*)",
      "Bash(gh release:*)",
      "Bash(gh auth:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin +*)",
      "Bash(git push origin --delete:*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/secrets/**)",
      "Read(./**/data/**)",
      "Read(./**/.auth/**)"
    ]
  }
}
