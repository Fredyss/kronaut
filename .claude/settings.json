{
  "permissions": {
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run rerun *)",
      "Bash(git push origin *)",
      "Bash(git fetch origin *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh release *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(git push -*)",
      "Bash(git push * -*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git fetch -*)",
      "Bash(git fetch * -*)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "mcp__cmux-cua",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.production)",
      "Read(/**/.env.development)",
      "Read(/**/.env.test)",
      "Read(/secrets/**)",
      "Read(/data/**)",
      "Read(/apps/server/e2e/.auth/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh pr create *",
      "gh pr view *",
      "gh pr list *",
      "gh pr checks *",
      "gh pr diff *",
      "gh pr edit *",
      "gh pr comment *",
      "gh run list *",
      "gh run view *",
      "gh run rerun *",
      "gh api *",
      "git push origin *",
      "git fetch origin *"
    ],
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/.env.local",
        "./**/.env.*.local",
        "./**/.env.production",
        "./**/.env.development",
        "./**/.env.test",
        "./secrets",
        "./data",
        "./apps/server/e2e/.auth",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.p12",
        "./**/*.pfx",
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/.npmrc"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    }
  }
}
