{
  "permissions": {
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.development.local)",
      "Read(.env.test)",
      "Read(.env.test.local)",
      "Read(.env.production)",
      "Read(.env.production.local)",
      "Read(.env.[a-df-zA-DF-Z0-9_~-]*)",
      "Read(.env.[eE][a-wy-zA-WY-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][b-zB-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][aA][a-ln-zA-LN-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][aA][mM][a-oq-zA-OQ-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][aA][mM][pP][a-km-zA-KM-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][aA][mM][pP][lL][a-df-zA-DF-Z0-9_.~-]*)",
      "Read(.env.[eE][xX][aA][mM][pP][lL][eE][a-zA-Z0-9_.~-]*)",
      "Read(.env.[eE])",
      "Read(.env.[eE][xX])",
      "Read(.env.[eE][xX][aA])",
      "Read(.env.[eE][xX][aA][mM])",
      "Read(.env.[eE][xX][aA][mM][pP])",
      "Read(.env.[eE][xX][aA][mM][pP][lL])",
      "Read(/secrets/**)",
      "Read(/data/**)",
      "Read(/apps/server/e2e/.auth/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "mcp__cmux-cua",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh api *)",
      "Bash(gh release *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push -vf*)",
      "Bash(git push * -vf*)",
      "Bash(git push -qf*)",
      "Bash(git push * -qf*)",
      "Bash(git push -nf*)",
      "Bash(git push * -nf*)",
      "Bash(git push -df*)",
      "Bash(git push * -df*)",
      "Bash(git push * -*)",
      "Bash(git push * :*)",
      "Bash(git push * --delete *)",
      "Bash(git push *+*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh pr create *",
      "gh pr view *",
      "gh pr list *",
      "gh pr checks *",
      "gh pr diff *",
      "gh pr edit *",
      "gh pr comment *",
      "gh run list *",
      "gh run view *",
      "git push -u origin *",
      "git push origin *",
      "git fetch *"
    ],
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.development.local",
        "./.env.test",
        "./.env.test.local",
        "./.env.production",
        "./.env.production.local",
        "./**/.env",
        "./**/.env.local",
        "./**/.env.development",
        "./**/.env.development.local",
        "./**/.env.test",
        "./**/.env.test.local",
        "./**/.env.production",
        "./**/.env.production.local",
        "./.env.[a-df-zA-DF-Z0-9_~-]*",
        "./.env.[eE][a-wy-zA-WY-Z0-9_.~-]*",
        "./.env.[eE][xX][b-zB-Z0-9_.~-]*",
        "./.env.[eE][xX][aA][a-ln-zA-LN-Z0-9_.~-]*",
        "./.env.[eE][xX][aA][mM][a-oq-zA-OQ-Z0-9_.~-]*",
        "./.env.[eE][xX][aA][mM][pP][a-km-zA-KM-Z0-9_.~-]*",
        "./.env.[eE][xX][aA][mM][pP][lL][a-df-zA-DF-Z0-9_.~-]*",
        "./.env.[eE][xX][aA][mM][pP][lL][eE][a-zA-Z0-9_.~-]*",
        "./.env.[eE]",
        "./.env.[eE][xX]",
        "./.env.[eE][xX][aA]",
        "./.env.[eE][xX][aA][mM]",
        "./.env.[eE][xX][aA][mM][pP]",
        "./.env.[eE][xX][aA][mM][pP][lL]",
        "./**/.env.[a-df-zA-DF-Z0-9_~-]*",
        "./**/.env.[eE][a-wy-zA-WY-Z0-9_.~-]*",
        "./**/.env.[eE][xX][b-zB-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][a-ln-zA-LN-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][a-oq-zA-OQ-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][a-km-zA-KM-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][lL][a-df-zA-DF-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][lL][eE][a-zA-Z0-9_.~-]*",
        "./**/.env.[eE]",
        "./**/.env.[eE][xX]",
        "./**/.env.[eE][xX][aA]",
        "./**/.env.[eE][xX][aA][mM]",
        "./**/.env.[eE][xX][aA][mM][pP]",
        "./**/.env.[eE][xX][aA][mM][pP][lL]",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.p12",
        "./**/*.pfx",
        "./secrets",
        "./data",
        "./apps/server/e2e/.auth",
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/.npmrc"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["registry.npmjs.org"]
    }
  }
}
