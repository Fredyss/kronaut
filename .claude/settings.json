{
  "permissions": {
    "allow": ["Bash(gh *)", "Bash(git push origin *)", "Bash(git fetch *)"],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git push -*)",
      "Bash(git push * -*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./secrets/**)",
      "Read(./data/**)",
      "Read(./apps/server/e2e/.auth/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *", "git push *", "git fetch *"],
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/.env.local",
        "./**/.env.*.local",
        "./**/.env.production",
        "./**/.env.development",
        "./**/.env.test",
        "./secrets",
        "./data",
        "./apps/server/e2e/.auth",
        "./**/*.pem",
        "./**/*.key",
        "~/.ssh",
        "~/.aws",
        "~/.netrc",
        "~/.npmrc"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["registry.npmjs.org"]
    }
  }
}
