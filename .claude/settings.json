{
  "permissions": {
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run rerun *)",
      "Bash(git push origin *)",
      "Bash(git fetch origin *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh release *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(git push -*)",
      "Bash(git push * -*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Bash(git push * @)",
      "Bash(git push * @ *)",
      "Bash(git push origin)",
      "Bash(git push)",
      "Bash(git fetch -*)",
      "Bash(git fetch * -*)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "mcp__cmux-cua",
      "Read(/**/.env)",
      "Read(/**/.env.[a-df-zA-DF-Z0-9_~-]*)",
      "Read(/**/.env.[eE][a-wy-zA-WY-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][b-zB-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][aA][a-ln-zA-LN-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][aA][mM][a-oq-zA-OQ-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][aA][mM][pP][a-km-zA-KM-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][aA][mM][pP][lL][a-df-zA-DF-Z0-9_.~-]*)",
      "Read(/**/.env.[eE][xX][aA][mM][pP][lL][eE][a-zA-Z0-9_.~-]*)",
      "Read(/**/.env.[eE])",
      "Read(/**/.env.[eE][xX])",
      "Read(/**/.env.[eE][xX][aA])",
      "Read(/**/.env.[eE][xX][aA][mM])",
      "Read(/**/.env.[eE][xX][aA][mM][pP])",
      "Read(/**/.env.[eE][xX][aA][mM][pP][lL])",
      "Read(/secrets/**)",
      "Read(/data/**)",
      "Read(/apps/server/e2e/.auth/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh pr create *",
      "gh pr view *",
      "gh pr list *",
      "gh pr checks *",
      "gh pr diff *",
      "gh pr edit *",
      "gh pr comment *",
      "gh run list *",
      "gh run view *",
      "gh run rerun *",
      "gh api *",
      "git push origin *",
      "git fetch origin *"
    ],
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/.env.[a-df-zA-DF-Z0-9_~-]*",
        "./**/.env.[eE][a-wy-zA-WY-Z0-9_.~-]*",
        "./**/.env.[eE][xX][b-zB-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][a-ln-zA-LN-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][a-oq-zA-OQ-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][a-km-zA-KM-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][lL][a-df-zA-DF-Z0-9_.~-]*",
        "./**/.env.[eE][xX][aA][mM][pP][lL][eE][a-zA-Z0-9_.~-]*",
        "./**/.env.[eE]",
        "./**/.env.[eE][xX]",
        "./**/.env.[eE][xX][aA]",
        "./**/.env.[eE][xX][aA][mM]",
        "./**/.env.[eE][xX][aA][mM][pP]",
        "./**/.env.[eE][xX][aA][mM][pP][lL]",
        "./secrets",
        "./data",
        "./apps/server/e2e/.auth",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.p12",
        "./**/*.pfx",
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/.npmrc"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    }
  }
}
